# ── সাপোর্ট বট (support_bot.py) ──
SUPPORT_BOT_TOKEN=নতুন_বটের_টোকেন
# এআই কী: OpenRouter ব্যবহার করলে এটা দিন (sk-or-...)
OPENROUTER_API_KEY=sk-or-...
# Anthropic সরাসরি ব্যবহার করলে (OpenRouter কী থাকলে এটা লাগবে না)
# ANTHROPIC_API_KEY=sk-ant-...
# এডমিনের টেলিগ্রাম আইডি (সংখ্যা)। এই অ্যাকাউন্টগুলো থেকে সাপোর্ট বটে একবার /start দিতে হবে, নইলে টিকেট আসবে না
ADMIN_IDS=123456789,987654321
# ঐচ্ছিক: প্রাইভেট এডমিন গ্রুপের আইডি (দিলে সব টিকেট গ্রুপে আসবে; বটকে গ্রুপে অ্যাড করুন)
ADMIN_GROUP_ID=
# মেইন বটের পাবলিক লিংক (শেষে / ছাড়া)
MAIN_BOT_API_URL=https://your-main-bot.onrender.com
# দুই বটে একই মান। বানাতে: python -c "import secrets; print(secrets.token_urlsafe(32))"
SUPPORT_API_SECRET=লম্বা_র‍্যান্ডম_টেক্সট

# ঐচ্ছিক সেটিংস
# OpenRouter মডেল (provider/model ফরম্যাটে), যেমন openai/gpt-4o-mini
# AI_MODEL=openai/gpt-4o-mini
# DAILY_AI_LIMIT=20
# DAILY_TICKET_LIMIT=5
# AI_FALLBACK_MODEL=anthropic/claude-3.5-haiku   # মূল মডেল ফেল করলে ব্যাকআপ (ঐচ্ছিক)
# TICKET_AUTO_CLOSE_HOURS=24
